DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
# Optional alias; copied into DATABASE_URL automatically if DATABASE_URL is absent.
NEON_DATABASE_URL=""

GEMINI_API_KEY=""
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"
AUTH_SESSION_SECRET="replace-with-random-secret"
ADMIN_EMAILS="founder@example.com"
APP_BASE_URL="http://localhost:8080"
PORT=8080

AUTH_RATE_LIMIT_PROVIDER="local"
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_MAX_PER_EMAIL=8
AUTH_VERIFY_MAX_ATTEMPTS=5
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
AUTH_TOKEN_RETENTION_HOURS=48
AUTH_MAINTENANCE_KEY="replace-with-maintenance-key"

EMAIL_PROVIDER="console"
EMAIL_FROM="no-reply@example.com"
RESEND_API_KEY=""

STORAGE_PROVIDER="local"
LOCAL_STORAGE_BASE_PATH=""
GCS_BUCKET_NAME=""
GOOGLE_CLOUD_PROJECT=""
GCS_SIGNED_URL_TTL_SECONDS=900
