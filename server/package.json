{
  "name": "hfe-server",
  "version": "1.0.0",
  "description": "Home Fall & Safety Evaluator - Backend Server",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "auth:cleanup": "npm run build && node dist/scripts/runCleanup.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^0.7.0",
    "@prisma/client": "^6.16.2",
    "@upstash/redis": "^1.37.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "prisma": "^6.16.2",
    "resend": "^6.10.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.11",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
