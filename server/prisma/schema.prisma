generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homes             Home[]
  sessions          InspectionSession[]
  authSessions      AuthSession[]
  loginTokens       EmailLoginToken[]
  reportSnapshots   ReportSnapshot[]
  evidenceAssets    EvidenceAsset[]
  contractorLeads   ContractorLead[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  lastSeenAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailLoginToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  attemptCount Int @default(0)
  lastAttemptAt DateTime?
  invalidatedAt DateTime?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
}

model Home {
  id          String   @id @default(cuid())
  userId      String
  city        String?
  homeType    String?
  floorCount  Int?
  hasElevator Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions InspectionSession[]

  @@index([userId])
}

model InspectionSession {
  id                 String   @id @default(cuid())
  userId             String
  homeId             String?
  status             String
  residentAge        Int?
  mobilityAid        String?
  fallHistory        Int?
  nightBathroomTrips Boolean?
  city               String?
  currentRoom        String?
  overallRiskLevel   String?
  conversationHistory Json?
  startedAt          DateTime @default(now())
  endedAt            DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  home            Home?              @relation(fields: [homeId], references: [id], onDelete: SetNull)
  roomScans       RoomScan[]
  observations    HazardObservation[]
  finalHazards    FinalHazard[]
  recommendations Recommendation[]
  reportSnapshots ReportSnapshot[]
  evidenceAssets  EvidenceAsset[]

  @@index([userId, createdAt])
}

model RoomScan {
  id             String   @id @default(cuid())
  sessionId      String
  roomType       String
  coverageStatus String
  requiredViews  Json
  capturedViews  Json
  missingViews   Json
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session      InspectionSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  observations HazardObservation[]

  @@unique([sessionId, roomType])
}

model HazardObservation {
  id                  String   @id @default(cuid())
  sessionId           String
  roomScanId          String?
  roomType            String
  hazardType          String
  severityHint        String?
  evidenceImagePath   String?
  modelNote           String?
  followUpNeeded      Boolean  @default(false)
  status              String
  evidenceAssetId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  session       InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  roomScan      RoomScan?         @relation(fields: [roomScanId], references: [id], onDelete: SetNull)
  evidenceAsset EvidenceAsset?    @relation(fields: [evidenceAssetId], references: [id], onDelete: SetNull)
}

model FinalHazard {
  id               String   @id @default(cuid())
  sessionId        String
  roomType         String
  hazardType       String
  severity         String
  reason           String
  priority         String
  evidenceImagePath String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  session         InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
}

model Recommendation {
  id                     String   @id @default(cuid())
  sessionId              String
  finalHazardId          String
  fixType                String
  title                  String
  description            String
  priority               String
  estimatedCostMin       Int?
  estimatedCostMax       Int?
  materialsJson          Json?
  installationComplexity String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  session    InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  finalHazard FinalHazard      @relation(fields: [finalHazardId], references: [id], onDelete: Cascade)
}

model ReportSnapshot {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  reportJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model ContractorLead {
  id           String   @id @default(cuid())
  userId       String
  name         String
  email        String
  zip          String
  phone        String?
  scopeSummary String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EvidenceAsset {
  id                  String   @id @default(cuid())
  userId              String
  sessionId           String
  roomType            String?
  hazardObservationId String?
  storageProvider     String
  storageKey          String
  publicUrl           String?
  mimeType            String?
  width               Int?
  height              Int?
  createdAt           DateTime @default(now())

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       InspectionSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  observations  HazardObservation[]
}
