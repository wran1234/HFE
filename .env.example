# Required
DATABASE_URL=postgresql://user:password@host/dbname
GEMINI_API_KEY=your-gemini-api-key
AUTH_SESSION_SECRET=generate-a-long-random-string

# Auth (optional but recommended for production)
AUTH_MAINTENANCE_KEY=generate-a-long-random-string
AUTH_RATE_LIMIT_PROVIDER=local          # or: upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email
EMAIL_PROVIDER=console                  # or: resend
RESEND_API_KEY=

# Storage
STORAGE_PROVIDER=local                  # or: gcs
GCS_BUCKET_NAME=
GOOGLE_CLOUD_PROJECT=
GCS_SIGNED_URL_TTL_SECONDS=900

# CORS
ALLOWED_ORIGIN=http://localhost:5173    # production: https://yourdomain.com

# Monitoring (optional)
SENTRY_DSN=

# Client (Vite)
VITE_SENTRY_DSN=
